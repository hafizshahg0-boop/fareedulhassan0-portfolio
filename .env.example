# Copy this file to `.env.local` for local development.
# Find both values in Supabase → Project Settings → API.

# Public project URL and anon (public) key. These are safe in the browser:
# Row Level Security in database/schema.sql decides what each user may do.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The address your site is published at (used for SEO, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Any long random string. Vercel sends it to /api/keep-alive so only the scheduled
# job can call it. That job stops the free Supabase database from pausing.
CRON_SECRET=change-me-to-a-long-random-string
